{
  "name": "shizuha-admin-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:dashboard": "node tests/unit/dashboardMetrics.test.mjs",
    "prebuild": "npm run test:dashboard && npm run test:security && npm run test:admin-state",
    "test:security": "node tests/security/axios-http.test.mjs && node tests/security/tooling-parsers.test.mjs",
    "test:admin-state": "node tests/unit/adminLoadState.test.mjs"
  },
  "dependencies": {
    "@shizuha/ui": "file:vendor/ui.tgz",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.0",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^3.2.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-organizational-chart": "^2.2.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "minimatch": "10.2.6",
    "js-yaml": "^4.3.2",
    "nanoid": "3.3.18"
  }
}
